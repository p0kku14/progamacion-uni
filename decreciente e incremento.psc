Algoritmo ejercicio
	// definir vaRIABLES
	Definir  i , j , num Como Entero
	//pedir valor
	Escribir "dame un numero:"
	leer num
	//inicar ciclo for
	Para i<-1  Hasta num Con Paso 1 Hacer
		Escribir "",i Sin Saltar
		Escribir "    " Sin Saltar
		Para j<-num-i Hasta 0 Con Paso -1 Hacer
			Escribir "*" Sin Saltar
		Fin Para
		escribir "" 
	Fin Para
FinAlgoritmo
